# =============================================================================
# Gestão de Assistências — variáveis de ambiente
# Copie para .env localmente. Na Vercel, configure em Project → Settings → Environment Variables.
# NUNCA commite o arquivo .env ou JSON de service account.
# =============================================================================

# URL pública do app (links de pagamento, e-mails, página /pagamento/{token})
# Local: http://localhost:3000
# Produção: https://seu-projeto.vercel.app
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Firebase Web SDK (expostas no frontend — restrinja domínios no Firebase Console)
# Firebase Console → Configurações do projeto → Seus apps → SDK
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# -----------------------------------------------------------------------------
# Firebase Admin SDK (server only — NUNCA no frontend)
# Local: FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Vercel: FIREBASE_SERVICE_ACCOUNT=<JSON completo OU base64 do JSON>
# -----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# -----------------------------------------------------------------------------
# Google Sheets — catálogo de peças (server only)
# Local: GOOGLE_SERVICE_ACCOUNT_PATH=google-service-account.json
# Vercel: GOOGLE_SERVICE_ACCOUNT=<JSON ou base64>
# -----------------------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SERVICE_ACCOUNT=
GOOGLE_SERVICE_ACCOUNT_PATH=google-service-account.json
CATALOG_SYNC_INTERVAL_MS=1800000

# -----------------------------------------------------------------------------
# E-mail — orçamento, RAT e rastreio (server only)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Alternativa: EMAIL_PROVIDER=resend + RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Correios — pré-postagem, etiquetas ZPL e código de rastreio (server only)
# -----------------------------------------------------------------------------
CORREIOS_TOKEN=""
CORREIOS_CONTRATO=""
CORREIOS_CARTAO_POSTAGEM=""

# -----------------------------------------------------------------------------
# Melhor Envio — cálculo de frete (server only)
# -----------------------------------------------------------------------------
MELHOR_ENVIO_CLIENT_ID=""
MELHOR_ENVIO_CLIENT_SECRET=""
MELHOR_ENVIO_REFRESH_TOKEN=""
MELHOR_ENVIO_ACCESS_TOKEN=""
MELHOR_ENVIO_BASE_URL="https://melhorenvio.com.br"
MELHOR_ENVIO_USER_AGENT="Gestao Assistencias (seu-email@empresa.com.br)"
cep_origem="50030917"

# -----------------------------------------------------------------------------
# Pagar.me — pagamentos (server only)
# Webhook produção: https://seu-projeto.vercel.app/api/pagarme/webhook
# -----------------------------------------------------------------------------
PAGARME_SECRET_KEY=""
PAGARME_PUBLIC_KEY=""
PAGARME_ACCOUNT_ID=""
PAGARME_BASE_URL="https://api.pagar.me/core/v5"

# -----------------------------------------------------------------------------
# Hub de Testes (server only — URL com token, nunca expor no frontend)
# -----------------------------------------------------------------------------
HUB_TESTES_URL=""

# -----------------------------------------------------------------------------
# Gemini AI (opcional)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""
